{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "epc-www",
  "main": "functions/worker.ts",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "out-cf",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/vision", "/vision/"]
  },
  "routes": [
    { "pattern": "embankment.org", "custom_domain": true },
    { "pattern": "www.embankment.org", "custom_domain": true },
    { "pattern": "dev.embankment.org", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "epc",
      "database_id": "cb01f940-c3f6-4c35-82cd-8a352967ab0d",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
