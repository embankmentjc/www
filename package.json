    "cf:deploy-preview": "npm run build:cf && wrangler versions upload --preview-alias preview",
    "build:cf": "vite build --outDir out-cf && scripts/generate-static-pages.sh out-cf && node scripts/inject-og-tags.cjs out-cf",
    "og:vision": "scripts/vision-og.py"
  },
